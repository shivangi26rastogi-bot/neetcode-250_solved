class Solution {
    public boolean containsDuplicate(int[] nums) {
        
        boolean result = duplicate(nums);
        return result;
    }

    // two pointers 
    public static boolean duplicate(int[] nums){

        Arrays.sort(nums);
        int i = 0 ;
        int j = nums.length-1;

        while(i<j){
            if(nums[i] == nums[i+1] ){
                return true;
            }
            i++;
        }

        return false;
    }
}
