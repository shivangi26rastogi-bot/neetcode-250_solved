class Solution {
    public int majorityElement(int[] nums) {
        
        int max_occur = (int)nums.length/2;
        int element = -1;

        HashMap<Integer,Integer> map = new HashMap<>();

        for(int n : nums){
            map.put(n,map.getOrDefault(n,0)+1);
        }

        for(int n : nums){
            if(map.get(n) > max_occur){
                element = n;
            }
        }

        return element ;
    }
}
